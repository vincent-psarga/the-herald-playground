{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Vitest and Vite both load these files as modules, unlike the CommonJS the
    // published library is built into, so import.meta is available here.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.d.mts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": []
}
